DATABASE_URL=postgresql://user@localhost:5432/survivor
SESSION_SECRET=replace-with-a-long-random-string
# Used to send "forgot password" emails — see app/mailer.server.ts.
# MAILGUN_DOMAIN is the sending domain configured in Mailgun (e.g.
# mg.yourdomain.com), not your app's own domain.
MAILGUN_API_KEY=replace-with-your-mailgun-private-api-key
MAILGUN_DOMAIN=replace-with-your-mailgun-sending-domain
# Optional — defaults to a no-reply address on MAILGUN_DOMAIN.
MAILGUN_FROM=Fantasy Survivor <no-reply@replace-with-your-mailgun-sending-domain>
